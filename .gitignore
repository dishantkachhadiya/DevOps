# ============================================================
# DevOps Repository — .gitignore
# ============================================================

# ---------------------------
# Terraform
# ---------------------------
**/.terraform/
**/.terraform.tfstate.lock.info
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/crash.*.log
**/*.tfvars
**/*.tfvars.json
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json
**/.terraformrc
**/terraform.rc

# ---------------------------
# Secrets & credentials
# ---------------------------
*.pem
*.key
.env
.env.*
**/secrets/
**/*credentials*

# ---------------------------
# Logs & temp files
# ---------------------------
*.log
*.tmp
*.bak
*.swp
*.swo

# ---------------------------
# OS-generated files
# ---------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------
# Editor / IDE files
# ---------------------------
.vscode/
.idea/
*.sublime-workspace

# ---------------------------
# Archives (avoid committing large binary backups)
# ---------------------------
*.tar.gz
*.zip
